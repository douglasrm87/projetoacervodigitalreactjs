# Configuração do Supabase - Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha com suas credenciais

# URL do seu projeto Supabase
# Obtém em: https://app.supabase.com > Configurações > API
REACT_APP_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave Anônima (public) do Supabase
# Obtém em: https://app.supabase.com > Configurações > API
REACT_APP_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Notas Importantes:
# 1. Nunca commit .env.local para GitHub (está em .gitignore)
# 2. Apenas a chave ANON_KEY deve ser usada no frontend
# 3. Use SERVICE_ROLE_KEY apenas no backend (não adicione aqui)
# 4. Reinicie npm start após alterar variáveis de ambiente
